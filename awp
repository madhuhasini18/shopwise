    }

    var ob = {
        name: n,
        branch: b,
        year: y,
        cgpa: c
    };

    update(ref(dbref, "Student/" + r), ob)
    .then(() => {
        alert("Student Data Updated Successfully");
    })
    .catch(error => alert(error.message));

}


