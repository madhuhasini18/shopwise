            {weather.main.humidity} %
          </p>

          <p>
            <strong>Weather:</strong>{" "}
            {weather.weather[0].description}
          </p>

          <p>
            <strong>Wind Speed:</strong>{" "}
            {weather.wind.speed} m/s
          </p>

        </div>
      ) : (
        <p>Loading current weather...</p>
      )}


      {/* WEATHER GRAPH */}

      <h2>Weather Graph</h2>

      {history.length > 0 ? (
        <Line
          data={chartData}
          options={chartOptions}
        />
      ) : (
        <p>Loading weather graph...</p>
      )}

    </div>
  );
}

export default App;


